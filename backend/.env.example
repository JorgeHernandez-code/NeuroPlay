# Copy to .env and adjust. All values are optional.
#
# By default the app uses a local SQLite file (backend/neuroplay.db) and needs
# no configuration at all.

# --- Option A: any SQLAlchemy URL (Postgres, MySQL, SQLite, ...) ------------
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/neuroplay
# DATABASE_URL=sqlite:///./neuroplay.db

# --- Option B: SQL Server via discrete vars (requires `pip install pyodbc`) -
# SQLSERVER_SERVER=localhost\SQLEXPRESS
# SQLSERVER_DATABASE=NeuroPlayDB
# SQLSERVER_USER=sa
# SQLSERVER_PASSWORD=YourStrongPassword
# ODBC_DRIVER=ODBC Driver 17 for SQL Server
